rules_version = '2';

// JBLBase security rules.
//
// - Every user reads and writes only below users/{uid}.
// - The role "admin" is a custom claim on the Firebase account. Single
//   permissions for normal users (1.2.35) are the custom claim
//   perms: { <name>: true }. Both are set only by the Admin SDK: the
//   function adminSetPermissions (callable by admins only) or
//   scripts/set-role.mjs, never by the app itself. roles/{uid} mirrors
//   them read-only for the account.
// - Users store their own evaluations up to depth 28. Proven mates are
//   always allowed, because engines report them with an artificial depth.
//   Admins have no limit.
// - The shared position store evals/{id} can be read by every signed-in
//   user, but only admins may write to it.
// - A repertoire is shared only on purpose (#120): shares/{id} holds a copy
//   for one recipient (e-mail address or Lichess name). Only the owner and
//   that recipient can read it; the owner can update or withdraw it, the
//   recipient can accept or decline it. users/{uid} stays private.
// - JBL Coach: users/{uid}/coach/state is the player's own coach state;
//   coachProfiles/{uid} is written only by the admin (console) and read by
//   the player.
//
// Keep USER_MAX_DEPTH in sync with USER_MAX_STORE_DEPTH in
// src-tauri/src/eval_cache.rs.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.get('admin', false) == true;
    }

    // A single permission (1.2.35): admins have all of them. Keep the names
    // in sync with PERMISSIONS in functions/src/roles.ts and
    // src/utils/cloud/permissions.ts.
    function hasPerm(name) {
      return signedIn()
        && (isAdmin() || request.auth.token.get('perms', {}).get(name, false) == true);
    }

    // The cloud is private: only accounts on the allowlist config/access
    // (lower-case e-mail addresses and Lichess usernames) and admins get in.
    // The list is edited in the Firebase console; the app cannot read it.
    // E-mail accounts count only once the address is confirmed.
    function accessList() {
      return get(/databases/$(database)/documents/config/access).data;
    }

    function listedEmail() {
      return request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', null) is string
        && accessList().get('emails', []).hasAny([request.auth.token.email.lower()]);
    }

    function listedLichess() {
      return request.auth.token.get('lichess', null) is string
        && accessList().get('lichess', []).hasAny([request.auth.token.lichess.lower()]);
    }

    function member() {
      return signedIn()
        && (isAdmin()
          || (exists(/databases/$(database)/documents/config/access)
            && (listedEmail() || listedLichess())));
    }

    function isOwner(uid) {
      return member() && request.auth.uid == uid;
    }

    function userMaxDepth() {
      return 28;
    }

    // One engine line as stored by the local position store (StoredLine).
    function validLine(line) {
      return line is map
        && line.keys().hasAll(['multipv', 'depth', 'uci'])
        && line.multipv is int && line.multipv >= 1
        && line.depth is int && line.depth >= 1
        && line.uci is list && line.uci.size() <= 64
        && (!('cp' in line) || line.cp is int)
        && (!('mate' in line) || line.mate is int);
    }

    // Evaluation document. The id is built by the app from engine and
    // position; the fields are checked here so nobody can store garbage.
    function validEval(d) {
      return d.keys().hasOnly(['position', 'engine', 'depth', 'multipv', 'lines', 'updatedAt'])
        && d.keys().hasAll(['position', 'engine', 'depth', 'multipv', 'lines', 'updatedAt'])
        && d.position is string && d.position.size() > 0 && d.position.size() <= 100
        && d.engine is string && d.engine.size() > 0 && d.engine.size() <= 64
        && d.depth is int && d.depth >= 1 && d.depth <= 255
        && d.multipv is int && d.multipv >= 1 && d.multipv <= 5
        && d.lines is list && d.lines.size() >= 1 && d.lines.size() <= 5
        && validLine(d.lines[0])
        && (d.lines.size() < 2 || validLine(d.lines[1]))
        && (d.lines.size() < 3 || validLine(d.lines[2]))
        && (d.lines.size() < 4 || validLine(d.lines[3]))
        && (d.lines.size() < 5 || validLine(d.lines[4]))
        && d.updatedAt == request.time;
    }

    // Synced repertoire file (pgn below Firestore's 1 MB document limit).
    // The content is either plain text (pgn) or, for big files, gzip-compressed
    // bytes (pgnGz), never both. See src/utils/cloud/repertoireSync.ts.
    function validRepertoire(d) {
      return d.keys().hasOnly(['path', 'info', 'pgn', 'pgnGz', 'hash', 'updatedAt', 'deleted', 'syncedAt'])
        && d.keys().hasAll(['path', 'info', 'hash', 'updatedAt', 'deleted', 'syncedAt'])
        && d.path is string && d.path.size() > 0 && d.path.size() <= 500
        && d.info is string && d.info.size() <= 10000
        && (
          (d.keys().hasAll(['pgn']) && !d.keys().hasAny(['pgnGz'])
            && d.pgn is string && d.pgn.size() <= 900000)
          || (d.keys().hasAll(['pgnGz']) && !d.keys().hasAny(['pgn'])
            && d.pgnGz is bytes && d.pgnGz.size() <= 900000)
        )
        && d.hash is string && d.hash.size() <= 64
        && d.updatedAt is number
        && d.deleted is bool
        && d.syncedAt == request.time;
    }

    function validCard(d) {
      return d.keys().hasOnly(['deck', 'position', 'fen', 'answer', 'card', 'ord', 'updatedAt', 'deleted', 'syncedAt'])
        && d.keys().hasAll(['deck', 'position', 'fen', 'answer', 'card', 'ord', 'updatedAt', 'deleted', 'syncedAt'])
        && d.deck is string && d.deck.size() <= 200
        && d.position is string && d.position.size() <= 100
        && d.fen is string && d.fen.size() <= 100
        && d.answer is string && d.answer.size() <= 20
        && d.card is string && d.card.size() <= 2000
        && d.ord is int
        && d.updatedAt is number
        && d.deleted is bool
        && d.syncedAt == request.time;
    }

    function validReview(d) {
      return d.keys().hasOnly(['deck', 'fen', 'log', 'reviewedAt', 'syncedAt'])
        && d.keys().hasAll(['deck', 'fen', 'log', 'reviewedAt', 'syncedAt'])
        && d.deck is string && d.deck.size() <= 200
        && d.fen is string && d.fen.size() <= 100
        && d.log is string && d.log.size() <= 2000
        && d.reviewedAt is number
        && d.syncedAt == request.time;
    }

    // The best line (multipv 1) is a mate. If any line mates, the best one
    // does too, so checking the first line is enough.
    function isMate(d) {
      return 'mate' in d.lines[0];
    }

    // Agreement to the terms of use and the privacy policy. The id is
    // "<terms version>_<privacy version>"; acceptedAt is the server time.
    function validConsent(id, d) {
      return d.keys().hasOnly(['terms', 'privacy', 'method', 'ageConfirmed', 'appVersion', 'acceptedAt'])
        && d.keys().hasAll(['terms', 'privacy', 'method', 'ageConfirmed', 'appVersion', 'acceptedAt'])
        && d.terms is string && d.terms.size() > 0 && d.terms.size() <= 20
        && d.privacy is string && d.privacy.size() > 0 && d.privacy.size() <= 20
        && id == d.terms + '_' + d.privacy
        && d.method in ['register', 'lichess', 'update']
        && d.ageConfirmed == true
        && d.appVersion is string && d.appVersion.size() <= 32
        && d.acceptedAt == request.time;
    }

    // Depth limit for normal users; admins, the permission deepEvals and
    // mates are exempt.
    function withinUserLimit(d) {
      return hasPerm('deepEvals')
        || isMate(d)
        || (d.depth <= userMaxDepth() && d.lines[0].depth <= userMaxDepth());
    }

    // Profile: linked accounts (Lichess, Chess.com username), settings.
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['lichess', 'chesscom', 'settings', 'updatedAt'])
        && (!('lichess' in request.resource.data) || request.resource.data.lichess is string)
        && (!('chesscom' in request.resource.data) || request.resource.data.chesscom is string)
        && (!('settings' in request.resource.data) || request.resource.data.settings is map);

      // Consent records: created once per version, never changed. Deleted
      // only together with the account.
      match /consents/{consentId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && validConsent(consentId, request.resource.data);
      }

      // Repertoires, synced as whole files (phase 3, see
      // src/utils/cloud/repertoireSync.ts). Deleted ones keep a mark.
      match /repertoires/{repId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validRepertoire(request.resource.data);
        match /moves/{moveId} {
          allow read, write: if isOwner(uid);
        }
      }

      // Training cards, last change wins (see src/utils/cloud/trainingSync.ts).
      match /cards/{cardId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validCard(request.resource.data);
      }

      // Append-only review log. Uploading the same review again (after an
      // interrupted sync) only touches syncedAt.
      match /reviews/{reviewId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && validReview(request.resource.data);
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['syncedAt'])
          && request.resource.data.syncedAt == request.time;
      }

      // Cloud usage per day (#114): one map of counts per device, written
      // by the app at the end of each sync run. The id is the local date.
      match /usage/{day} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.size() <= 20
          && request.resource.data.updatedAt == request.time;
      }

      // JBL Coach (1.2.4): one document with XP per device, collected
      // rewards, streak and settings (see src/components/coach/coachSync.ts).
      match /coach/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && docId == 'state'
          && request.resource.data.keys().hasOnly(
            ['xpByDevice', 'sets', 'streak', 'best', 'bundle', 'bundleAt', 'updatedAt'])
          && request.resource.data.xpByDevice is map
          && request.resource.data.xpByDevice.size() <= 20
          && request.resource.data.sets is map
          && request.resource.data.bundle is map
          && request.resource.data.updatedAt == request.time;
      }

      // Own evaluations, limited to depth 28 for normal users.
      match /evals/{evalId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && validEval(request.resource.data)
          && withinUserLimit(request.resource.data);
      }
    }

    // Coach profile (birthday, personal easter eggs, rival), entered by the
    // admin in the Firebase console. The player can read it, nobody can
    // write it through the app.
    match /coachProfiles/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Boss-Buch (1.2.7): Stellungen mit den Zügen des Bosses, kompakt als
    // "epd|uci|weight". Alle Mitglieder lesen, nur Admins schreiben.
    match /bossBook/{docId} {
      allow read: if member();
      allow create, update: if isAdmin()
        && docId == 'main'
        && request.resource.data.keys().hasOnly(['moves', 'count', 'updatedAt'])
        && request.resource.data.moves is list
        && request.resource.data.moves.size() <= 8000
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    // Duell (1.2.7): wer im Coach-Profil als Rivale steht
    function rivalOf(uid) {
      return get(/databases/$(database)/documents/coachProfiles/$(uid)).data.get('rival', null);
    }

    // Level und XP für den Rivalen. Lesen darf nur, wer diesen Spieler im
    // eigenen Coach-Profil als Rivalen hat.
    match /coachRivals/{uid} {
      allow read: if isOwner(uid) || (signedIn() && rivalOf(request.auth.uid) == uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['level', 'xp', 'name', 'updatedAt'])
        && request.resource.data.level is int
        && request.resource.data.xp is number
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(uid);
    }

    // Duell-Partien zwischen zwei Rivalen. Nur die beiden lesen und
    // schreiben; ein Zug pro Schreiben, fertige Partien bleiben fertig.
    match /duels/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.players;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
          ['players', 'white', 'black', 'names', 'moves', 'result', 'reason', 'createdAt', 'updatedAt'])
        && request.resource.data.players is list
        && request.resource.data.players.size() == 2
        && request.resource.data.players[0] == request.auth.uid
        && request.resource.data.players[1] == rivalOf(request.auth.uid)
        && request.resource.data.white in request.resource.data.players
        && request.resource.data.black in request.resource.data.players
        && request.resource.data.white != request.resource.data.black
        && request.resource.data.names is map
        && request.resource.data.moves is list
        && request.resource.data.moves.size() == 0
        && request.resource.data.result == '*'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
        && request.auth.uid in resource.data.players
        && resource.data.result == '*'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['moves', 'result', 'reason', 'updatedAt'])
        && request.resource.data.moves is list
        && request.resource.data.moves.size() >= resource.data.moves.size()
        && request.resource.data.moves.size() <= resource.data.moves.size() + 1
        && request.resource.data.moves.size() <= 600
        && request.resource.data.result in ['*', '1-0', '0-1', '1/2-1/2']
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // A shared repertoire is meant for the account with this e-mail address
    // (confirmed) or this Lichess name.
    function isShareRecipient(d) {
      return signedIn()
        && (
          (request.auth.token.get('email_verified', false) == true
            && request.auth.token.get('email', null) is string
            && d.recipientKey == 'email:' + request.auth.token.email.lower())
          || (request.auth.token.get('lichess', null) is string
            && d.recipientKey == 'lichess:' + request.auth.token.lichess.lower())
        );
    }

    // The content of a share: the repertoire as text or gzip bytes, never
    // both (like validRepertoire), with its name and color.
    function validShareContent(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 200
        && d.color in ['white', 'black']
        && d.ownerName is string && d.ownerName.size() > 0 && d.ownerName.size() <= 80
        && d.hash is string && d.hash.size() <= 128
        && (
          (d.keys().hasAll(['pgn']) && !d.keys().hasAny(['pgnGz'])
            && d.pgn is string && d.pgn.size() <= 900000)
          || (d.keys().hasAll(['pgnGz']) && !d.keys().hasAny(['pgn'])
            && d.pgnGz is bytes && d.pgnGz.size() <= 900000)
        )
        && d.updatedAt == request.time;
    }

    // Shared repertoires (#120). Nobody can list shares of others: queries
    // must ask for ownerUid == own uid or recipientKey == own address/name.
    match /shares/{shareId} {
      allow read: if member()
        && (resource.data.ownerUid == request.auth.uid || isShareRecipient(resource.data));
      allow create: if member()
        && request.resource.data.keys().hasOnly(['ownerUid', 'ownerName', 'recipientKey', 'sourceId', 'name', 'color', 'pgn', 'pgnGz', 'hash', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['ownerUid', 'ownerName', 'recipientKey', 'sourceId', 'name', 'color', 'hash', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.recipientKey is string
        && request.resource.data.recipientKey.size() <= 210
        && request.resource.data.recipientKey.matches('^(email|lichess):[^ ]+$')
        && request.resource.data.sourceId is string
        && request.resource.data.sourceId.size() > 0 && request.resource.data.sourceId.size() <= 64
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && validShareContent(request.resource.data);
      // The owner sends a new version of the repertoire.
      allow update: if member()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerName', 'name', 'color', 'pgn', 'pgnGz', 'hash', 'updatedAt'])
        && validShareContent(request.resource.data);
      // The recipient accepts, once.
      allow update: if member()
        && isShareRecipient(resource.data)
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'recipientUid'])
        && request.resource.data.status == 'accepted'
        && request.resource.data.recipientUid == request.auth.uid;
      // The owner withdraws it, or the recipient declines or removes it.
      allow delete: if member()
        && (resource.data.ownerUid == request.auth.uid || isShareRecipient(resource.data));
    }

    // Shared position store: every member reads, admins write. Members with
    // the permission sharedEvals write too, within their depth limit.
    match /evals/{evalId} {
      allow read: if member();
      allow create, update: if validEval(request.resource.data)
        && (isAdmin()
          || (member() && hasPerm('sharedEvals') && withinUserLimit(request.resource.data)));
      allow delete: if isAdmin();
    }

    // Role and permissions of an account (1.2.35), written only by the
    // function adminSetPermissions. The account reads its own to notice a
    // change and refresh its token; admins read all.
    match /roles/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow write: if false;
    }

    // Usage limits per account and day (#114). Edited in the Firebase
    // console; missing fields fall back to the defaults in the app.
    match /config/limits {
      allow read: if member();
    }

    // Admin overview (#116): admins read the usage counts of all accounts
    // (a collection group query over users/*/usage) and how long the
    // allowlist is. The counts hold only numbers per device; nothing else
    // below users/{uid} becomes readable.
    match /{path=**}/usage/{day} {
      allow read: if isAdmin();
    }

    match /config/access {
      allow read: if isAdmin();
    }

    // Everything else is closed.
  }
}
