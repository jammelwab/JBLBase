rules_version = '2';

// JBLBase security rules.
//
// - Every user reads and writes only below users/{uid}.
// - The role "admin" is a custom claim on the Firebase account. It is set
//   only by scripts/set-role.mjs (Admin SDK), never by the app.
// - Users store their own evaluations up to depth 28. Proven mates are
//   always allowed, because engines report them with an artificial depth.
//   Admins have no limit.
// - The shared position store evals/{id} can be read by every signed-in
//   user, but only admins may write to it.
//
// Keep USER_MAX_DEPTH in sync with USER_MAX_STORE_DEPTH in
// src-tauri/src/eval_cache.rs.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.get('admin', false) == true;
    }

    // The cloud is private: only accounts on the allowlist config/access
    // (lower-case e-mail addresses and Lichess usernames) and admins get in.
    // The list is edited in the Firebase console; the app cannot read it.
    // E-mail accounts count only once the address is confirmed.
    function accessList() {
      return get(/databases/$(database)/documents/config/access).data;
    }

    function listedEmail() {
      return request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', null) is string
        && accessList().get('emails', []).hasAny([request.auth.token.email.lower()]);
    }

    function listedLichess() {
      return request.auth.token.get('lichess', null) is string
        && accessList().get('lichess', []).hasAny([request.auth.token.lichess.lower()]);
    }

    function member() {
      return signedIn()
        && (isAdmin()
          || (exists(/databases/$(database)/documents/config/access)
            && (listedEmail() || listedLichess())));
    }

    function isOwner(uid) {
      return member() && request.auth.uid == uid;
    }

    function userMaxDepth() {
      return 28;
    }

    // One engine line as stored by the local position store (StoredLine).
    function validLine(line) {
      return line is map
        && line.keys().hasAll(['multipv', 'depth', 'uci'])
        && line.multipv is int && line.multipv >= 1
        && line.depth is int && line.depth >= 1
        && line.uci is list && line.uci.size() <= 64
        && (!('cp' in line) || line.cp is int)
        && (!('mate' in line) || line.mate is int);
    }

    // Evaluation document. The id is built by the app from engine and
    // position; the fields are checked here so nobody can store garbage.
    function validEval(d) {
      return d.keys().hasOnly(['position', 'engine', 'depth', 'multipv', 'lines', 'updatedAt'])
        && d.keys().hasAll(['position', 'engine', 'depth', 'multipv', 'lines', 'updatedAt'])
        && d.position is string && d.position.size() > 0 && d.position.size() <= 100
        && d.engine is string && d.engine.size() > 0 && d.engine.size() <= 64
        && d.depth is int && d.depth >= 1 && d.depth <= 255
        && d.multipv is int && d.multipv >= 1 && d.multipv <= 5
        && d.lines is list && d.lines.size() >= 1 && d.lines.size() <= 5
        && validLine(d.lines[0])
        && (d.lines.size() < 2 || validLine(d.lines[1]))
        && (d.lines.size() < 3 || validLine(d.lines[2]))
        && (d.lines.size() < 4 || validLine(d.lines[3]))
        && (d.lines.size() < 5 || validLine(d.lines[4]))
        && d.updatedAt == request.time;
    }

    // Synced repertoire file (pgn below Firestore's 1 MB document limit).
    function validRepertoire(d) {
      return d.keys().hasOnly(['path', 'info', 'pgn', 'hash', 'updatedAt', 'deleted', 'syncedAt'])
        && d.keys().hasAll(['path', 'info', 'pgn', 'hash', 'updatedAt', 'deleted', 'syncedAt'])
        && d.path is string && d.path.size() > 0 && d.path.size() <= 500
        && d.info is string && d.info.size() <= 10000
        && d.pgn is string && d.pgn.size() <= 900000
        && d.hash is string && d.hash.size() <= 64
        && d.updatedAt is number
        && d.deleted is bool
        && d.syncedAt == request.time;
    }

    function validCard(d) {
      return d.keys().hasOnly(['deck', 'position', 'fen', 'answer', 'card', 'ord', 'updatedAt', 'deleted', 'syncedAt'])
        && d.keys().hasAll(['deck', 'position', 'fen', 'answer', 'card', 'ord', 'updatedAt', 'deleted', 'syncedAt'])
        && d.deck is string && d.deck.size() <= 200
        && d.position is string && d.position.size() <= 100
        && d.fen is string && d.fen.size() <= 100
        && d.answer is string && d.answer.size() <= 20
        && d.card is string && d.card.size() <= 2000
        && d.ord is int
        && d.updatedAt is number
        && d.deleted is bool
        && d.syncedAt == request.time;
    }

    function validReview(d) {
      return d.keys().hasOnly(['deck', 'fen', 'log', 'reviewedAt', 'syncedAt'])
        && d.keys().hasAll(['deck', 'fen', 'log', 'reviewedAt', 'syncedAt'])
        && d.deck is string && d.deck.size() <= 200
        && d.fen is string && d.fen.size() <= 100
        && d.log is string && d.log.size() <= 2000
        && d.reviewedAt is number
        && d.syncedAt == request.time;
    }

    // The best line (multipv 1) is a mate. If any line mates, the best one
    // does too, so checking the first line is enough.
    function isMate(d) {
      return 'mate' in d.lines[0];
    }

    // Agreement to the terms of use and the privacy policy. The id is
    // "<terms version>_<privacy version>"; acceptedAt is the server time.
    function validConsent(id, d) {
      return d.keys().hasOnly(['terms', 'privacy', 'method', 'ageConfirmed', 'appVersion', 'acceptedAt'])
        && d.keys().hasAll(['terms', 'privacy', 'method', 'ageConfirmed', 'appVersion', 'acceptedAt'])
        && d.terms is string && d.terms.size() > 0 && d.terms.size() <= 20
        && d.privacy is string && d.privacy.size() > 0 && d.privacy.size() <= 20
        && id == d.terms + '_' + d.privacy
        && d.method in ['register', 'lichess', 'update']
        && d.ageConfirmed == true
        && d.appVersion is string && d.appVersion.size() <= 32
        && d.acceptedAt == request.time;
    }

    // Depth limit for normal users; admins and mates are exempt.
    function withinUserLimit(d) {
      return isAdmin()
        || isMate(d)
        || (d.depth <= userMaxDepth() && d.lines[0].depth <= userMaxDepth());
    }

    // Profile: linked accounts (Lichess, Chess.com username), settings.
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['lichess', 'chesscom', 'settings', 'updatedAt'])
        && (!('lichess' in request.resource.data) || request.resource.data.lichess is string)
        && (!('chesscom' in request.resource.data) || request.resource.data.chesscom is string)
        && (!('settings' in request.resource.data) || request.resource.data.settings is map);

      // Consent records: created once per version, never changed. Deleted
      // only together with the account.
      match /consents/{consentId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && validConsent(consentId, request.resource.data);
      }

      // Repertoires, synced as whole files (phase 3, see
      // src/utils/cloud/repertoireSync.ts). Deleted ones keep a mark.
      match /repertoires/{repId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validRepertoire(request.resource.data);
        match /moves/{moveId} {
          allow read, write: if isOwner(uid);
        }
      }

      // Training cards, last change wins (see src/utils/cloud/trainingSync.ts).
      match /cards/{cardId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validCard(request.resource.data);
      }

      // Append-only review log. Uploading the same review again (after an
      // interrupted sync) only touches syncedAt.
      match /reviews/{reviewId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && validReview(request.resource.data);
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['syncedAt'])
          && request.resource.data.syncedAt == request.time;
      }

      // Own evaluations, limited to depth 28 for normal users.
      match /evals/{evalId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && validEval(request.resource.data)
          && withinUserLimit(request.resource.data);
      }
    }

    // Shared position store: every member reads, only admins write.
    match /evals/{evalId} {
      allow read: if member();
      allow create, update: if isAdmin() && validEval(request.resource.data);
      allow delete: if isAdmin();
    }

    // Everything else is closed.
  }
}
