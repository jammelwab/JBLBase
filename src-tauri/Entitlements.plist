<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The app is only ad-hoc signed and has no Team ID. With the hardened
         runtime, macOS then refuses to load the bundled DuckDB extension
         (aixchess.duckdb_extension): "mapping process and mapped file
         (non-platform) have different Team IDs". -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
