{
  "bundle": {
    "active": true,
    "category": "BoardGame",
    "copyright": "",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "publisher": "Francisco Salgueiro",
    "shortDescription": "Ultimate Chess Toolkit",
    "longDescription": "",
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": "-"
    },
    "resources": {
      "../sound/": "sound/",
      "../aixchess.duckdb_extension": "aixchess.duckdb_extension",
      "resources/vision/": "vision/"
    },
    "targets": "all",
    "createUpdaterArtifacts": true
  },
  "build": {
    "beforeDevCommand": "pnpm prepare:aix-extension && pnpm start-vite",
    "beforeBuildCommand": "pnpm prepare:aix-extension && pnpm build-vite",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "productName": "JBLBase",
  "mainBinaryName": "en-croissant",
  "identifier": "de.jammelwab.jblbase",
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "encroissant"
        ]
      }
    },
    "cli": {
      "args": [
        {
          "name": "file",
          "index": 1,
          "takesValue": true
        }
      ]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM0NTY2QkZEQ0MwRjE4OTMKUldTVEdBL00vV3RXTk0rSmpRTVl2ZlVPWjFaSmxPbGtSVW55NzRBL3lLU3RpL2VMMmt5bHpYcEoK",
      "endpoints": [
        "https://github.com/jammelwab/JBLBase/releases/latest/download/latest.json"
      ]
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "JBLBase",
        "visible": false,
        "decorations": true
      }
    ],
    "security": {
      "assetProtocol": {
        "scope": [
          "**"
        ],
        "enable": true
      },
      "csp": null
    }
  }
}
